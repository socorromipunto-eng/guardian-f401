{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guardian-f401.dev/schema/governance/claim-transition/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_id",
    "claim_id",
    "claim_version",
    "from_assessment_state",
    "to_assessment_state",
    "from_adjudication_state",
    "to_adjudication_state",
    "assessment_record_id",
    "rule_id",
    "rule_version",
    "evidence_refs",
    "contradictory_evidence_refs",
    "source_commit",
    "source_tree",
    "created_at",
    "transition_reason"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "transition_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_version": {
      "type": "string",
      "minLength": 1
    },
    "from_assessment_state": {
      "enum": [
        "NOT_ASSESSED",
        "NOT_DEMONSTRATED",
        "PARTIALLY_DEMONSTRATED",
        "DEMONSTRATED",
        "CONTRADICTED",
        "INVALIDATED"
      ]
    },
    "to_assessment_state": {
      "enum": [
        "NOT_ASSESSED",
        "NOT_DEMONSTRATED",
        "PARTIALLY_DEMONSTRATED",
        "DEMONSTRATED",
        "CONTRADICTED",
        "INVALIDATED"
      ]
    },
    "from_adjudication_state": {
      "enum": [
        "UNADJUDICATED",
        "ACCEPTED",
        "REJECTED",
        "SUPERSEDED",
        "WITHDRAWN"
      ]
    },
    "to_adjudication_state": {
      "enum": [
        "UNADJUDICATED",
        "ACCEPTED",
        "REJECTED",
        "SUPERSEDED",
        "WITHDRAWN"
      ]
    },
    "assessment_record_id": {
      "type": "string",
      "minLength": 1
    },
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "rule_version": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "contradictory_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "transition_reason": {
      "type": "string",
      "minLength": 1
    },
    "adjudicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "adjudicated_at"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "adjudicated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*:[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "to_adjudication_state": {
            "enum": [
              "ACCEPTED",
              "REJECTED",
              "SUPERSEDED",
              "WITHDRAWN"
            ]
          }
        },
        "required": [
          "to_adjudication_state"
        ]
      },
      "then": {
        "required": [
          "adjudicator"
        ]
      }
    }
  ]
}
