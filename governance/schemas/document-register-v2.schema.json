{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guardian-f401.dev/schema/governance/document-register/v2",
  "title": "Guardian F401 Controlled Document Register v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "controlled_scope",
    "documents"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "controlled_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "completeness_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "completeness_status": {
          "enum": [
            "NOT_DEMONSTRATED",
            "CONFIRMED"
          ]
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      }
    }
  },
  "$defs": {
    "selector": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._:+*-]+$"
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/selector"
        },
        "chip_family": {
          "$ref": "#/$defs/selector"
        },
        "hardware_revision": {
          "$ref": "#/$defs/selector"
        },
        "firmware_version": {
          "$ref": "#/$defs/selector"
        },
        "protocol_version": {
          "$ref": "#/$defs/selector"
        },
        "semantic_profile": {
          "$ref": "#/$defs/selector"
        },
        "system_role": {
          "$ref": "#/$defs/selector"
        }
      }
    },
    "document_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "document_class",
        "version",
        "path",
        "sha256",
        "source_commit",
        "lifecycle_status",
        "authority_status",
        "authority_domain",
        "scope",
        "supersedes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "document_class": {
          "enum": [
            "ADR",
            "ARCHITECTURE",
            "SPECIFICATION",
            "GOVERNANCE",
            "EVIDENCE",
            "OPERATIONAL",
            "INFORMATIONAL"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "lifecycle_status": {
          "enum": [
            "DRAFT",
            "CANDIDATE",
            "APPROVED",
            "SUPERSEDED",
            "DEPRECATED",
            "WITHDRAWN"
          ]
        },
        "authority_status": {
          "enum": [
            "NONE",
            "AUTHORITATIVE"
          ]
        },
        "authority_domain": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "supersedes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/document_ref"
          }
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
