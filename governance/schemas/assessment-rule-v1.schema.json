{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guardian-f401.dev/schema/governance/assessment-rule/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rule_id",
    "rule_version",
    "required_evidence_classes",
    "material_contradiction_classes",
    "contradiction_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "rule_version": {
      "type": "string",
      "minLength": 1
    },
    "required_evidence_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "PHYSICAL_HARDWARE",
          "HOST_EXECUTION",
          "SIMULATOR",
          "BUILD",
          "STATIC_ANALYSIS",
          "UNIT_TEST",
          "INTEGRATION_TEST",
          "PROTOCOL_TEST",
          "FUZZ",
          "FORMAL_ANALYSIS",
          "DOCUMENT_REVIEW",
          "MANUAL_INSPECTION",
          "EXTERNAL_ATTESTATION"
        ]
      }
    },
    "material_contradiction_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "PHYSICAL_HARDWARE",
          "HOST_EXECUTION",
          "SIMULATOR",
          "BUILD",
          "STATIC_ANALYSIS",
          "UNIT_TEST",
          "INTEGRATION_TEST",
          "PROTOCOL_TEST",
          "FUZZ",
          "FORMAL_ANALYSIS",
          "DOCUMENT_REVIEW",
          "MANUAL_INSPECTION",
          "EXTERNAL_ATTESTATION"
        ]
      }
    },
    "max_age_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "contradiction_policy": {
      "const": "MATERIAL_CONTRADICTION_YIELDS_CONTRADICTED"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*:[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    }
  }
}
