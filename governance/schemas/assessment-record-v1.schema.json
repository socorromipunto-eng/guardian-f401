{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guardian-f401.dev/schema/governance/assessment-record/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_record_id",
    "claim_id",
    "claim_version",
    "rule_id",
    "rule_version",
    "assessment_state",
    "evidence_refs",
    "contradictory_evidence_refs",
    "source_commit",
    "source_tree",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "assessment_record_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_version": {
      "type": "string",
      "minLength": 1
    },
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "rule_version": {
      "type": "string",
      "minLength": 1
    },
    "assessment_state": {
      "enum": [
        "NOT_ASSESSED",
        "NOT_DEMONSTRATED",
        "PARTIALLY_DEMONSTRATED",
        "DEMONSTRATED",
        "CONTRADICTED",
        "INVALIDATED"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "contradictory_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*:[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    }
  }
}
