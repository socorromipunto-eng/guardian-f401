{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guardian-f401.dev/schema/governance/document-register/v2",
  "title": "Guardian F401 Governance Document Register",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "controlled_scope": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "completeness_status": {
          "type": "string",
          "enum": [
            "NOT_DEMONSTRATED",
            "PARTIAL",
            "DEMONSTRATED"
          ]
        }
      },
      "required": [
        "id",
        "description",
        "completeness_status"
      ],
      "additionalProperties": false
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      }
    }
  },
  "required": [
    "schema_version",
    "controlled_scope",
    "documents"
  ],
  "additionalProperties": false,
  "$defs": {
    "document": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "document_class": {
          "type": "string",
          "enum": [
            "ADR",
            "ARCHITECTURE",
            "GOVERNANCE",
            "SPECIFICATION"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9A-F]{64}$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "lifecycle_status": {
          "type": "string",
          "enum": [
            "CANDIDATE",
            "APPROVED",
            "SUPERSEDED",
            "RETIRED"
          ]
        },
        "authority_status": {
          "type": "string",
          "enum": [
            "NONE",
            "AUTHORITATIVE"
          ]
        },
        "authority_domain": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "document_class",
        "version",
        "path",
        "sha256",
        "source_commit",
        "lifecycle_status",
        "authority_status",
        "authority_domain",
        "scope",
        "supersedes"
      ],
      "additionalProperties": false
    }
  }
}