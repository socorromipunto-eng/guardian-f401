{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guardian-f401.dev/schema/governance/project-state/v2",
  "title": "Guardian F401 Governance Project State v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "binding_model",
    "source_commit",
    "source_tree",
    "registers"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "id": {
      "const": "guardian:project-state:current"
    },
    "binding_model": {
      "const": "PREDECESSOR_PAYLOAD_ATTESTATION"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "registers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/register"
      }
    }
  },
  "$defs": {
    "register": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schema_id",
        "schema_version",
        "schema_sha256",
        "register_sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^governance/[A-Za-z0-9._/-]+\\.json$"
        },
        "schema_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^[0-9A-F]{64}$"
        },
        "register_sha256": {
          "type": "string",
          "pattern": "^[0-9A-F]{64}$"
        }
      }
    }
  }
}
