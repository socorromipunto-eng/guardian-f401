{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guardian-f401.dev/schema/governance/capability-register/v1",
  "title": "Guardian F401 Governance Capability Register",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "required": [
    "schema_version",
    "capabilities"
  ],
  "additionalProperties": false,
  "$defs": {
    "capability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^guardian:capability:[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
          "maxLength": 96
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "IMPLEMENTED",
            "PARTIAL",
            "NOT_IMPLEMENTED"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "status"
      ],
      "additionalProperties": false
    }
  }
}
