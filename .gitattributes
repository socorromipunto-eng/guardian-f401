# Normalize source and documentation files to LF inside the repository.
* text=auto

# Keep C source files deterministic across Windows and Linux build environments.
*.c text eol=lf

# Keep C header files deterministic across Windows and Linux build environments.
*.h text eol=lf

# Keep Python source files deterministic across Windows and Linux test environments.
*.py text eol=lf

# Keep YAML workflow files deterministic across GitHub-hosted runners.
*.yml text eol=lf

# Keep alternate YAML workflow files deterministic across GitHub-hosted runners.
*.yaml text eol=lf

# Keep Markdown documentation deterministic across platforms.
*.md text eol=lf

# Keep binary fuzz corpus entries byte-exact across every platform.
*.bin -text

# Keep CSV evidence manifests deterministic across platforms.
*.csv text eol=lf

# Keep plain-text manifests and notices deterministic across platforms.
*.txt text eol=lf

# Keep JSON evidence deterministic across platforms.
*.json text eol=lf

# Keep the built firmware image byte-exact; never apply text normalization.
*.hex text eol=lf

# Keep compiled and archive artifacts byte-exact.
*.npz -text
*.zip -text

# Keep ignore files deterministic across platforms.
.gitignore text eol=lf
CITATION.cff text eol=lf
VERSION text eol=lf
.gitattributes text eol=lf
